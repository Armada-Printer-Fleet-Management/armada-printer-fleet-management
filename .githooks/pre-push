#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — runs type checks and tests before anything reaches the remote.
#
# This file only orchestrates: shared helpers live in pre-push.d/_lib.sh, and
# each service's own checks live in pre-push.d/<service>/check.sh. Add a new
# service by adding a new subdirectory there -- this dispatcher never changes.
#
# A gate applies when the code it checks exists in the repo. Once it applies it
# is mandatory: a missing tool fails the push rather than being waved through,
# so nobody pushes code they cannot verify.
#
# Only projects this branch changes are checked, with everything that depends on
# them (scripts/affected_projects.py); `require` skips the rest by itself. Slow or
# environment-heavy suites (Docker, browser, WASM) use `require_exhaustive`: CI
# runs them on every pull request, so a push does not.
#
#   PRE_PUSH_BASE=<ref>    compare against <ref> instead of origin/main
#   PRE_PUSH_ALL=1         check every project, changed or not
#   PRE_PUSH_EXHAUSTIVE=1  also run the CI-only suites
#
# Deliberate bypass:  git push --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1
# Git passes the refs being pushed on stdin; Git LFS needs them at the end to upload large files.
PUSHED_REFS="$(cat)"
# shellcheck source=.githooks/pre-push.d/_lib.sh
source .githooks/pre-push.d/_lib.sh

FAILED=0
NA=()
RAN=0
SKIPPED_UNCHANGED=0
SKIPPED_CI_ONLY=0
HOOK_START="$(now)"
# Stale bytecode left by other branches breaks imports and structure tests; write none.
export PYTHONDONTWRITEBYTECODE=1

PY="$(find_python || true)"
if [ -n "$PY" ]; then
  AFFECTED="$("$PY" scripts/affected_projects.py)" || AFFECTED="ALL"
fi

echo "pre-push checks:"
if [ "$AFFECTED" = "ALL" ]; then
  dim "  checking every project"
else
  dim "  checking changed projects: $(printf '%s' "$AFFECTED" | tr '\n' ' ')"
fi

# ── Protobuf contract (shared across every service, not per-service) ────────
if [ -f buf.yaml ]; then
  if any_affected packages/proto/utils; then
    require "buf lint" buf buf lint
  else
    skip_unchanged "buf lint" packages/proto
  fi
  # Shared generated Python code; every Python check below imports it, so it is
  # regenerated before them whenever any Python project is checked.
  # `--project=` rather than `--project <dir>`, so require does not scope it to proto utils alone.
  if any_affected packages/proto/utils apps/server apps/desktop/backend; then
    require "python gen" uv uv run --project=packages/proto/utils python scripts/generate_proto.py buf.gen.python.yaml
  else
    skip_unchanged "python gen" "any Python project"
  fi
  require "proto utils" uv run_in packages/proto/utils uv run pytest -q
  require "proto pyright" uv run_in packages/proto/utils uv run pyright
else
  NA+=("protobuf")
fi

# ── Per-service checks ────────────────────────────────────────────────────────
for service_dir in .githooks/pre-push.d/*/; do
  check="${service_dir}check.sh"
  if [ -f "$check" ]; then
    # shellcheck source=/dev/null
    source "$check"
  fi
done

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
dim "ran $RAN, skipped $SKIPPED_UNCHANGED unchanged, skipped $SKIPPED_CI_ONLY CI-only, in $(elapsed "$HOOK_START")"
if [ ${#NA[@]} -gt 0 ]; then
  dim "not applicable (no such code in repo yet): ${NA[*]}"
fi

if [ $FAILED -ne 0 ]; then
  red "✗ Push aborted."
  exit 1
fi

# core.hooksPath replaces Git LFS's own pre-push hook, so its upload runs here. Without it the push
# would carry LFS pointers whose files never reach the remote.
if git lfs version >/dev/null 2>&1; then
  printf '%s\n' "$PUSHED_REFS" | git lfs pre-push "$@" || exit 1
elif git ls-files ':(attr:filter=lfs)' | grep -q .; then
  red "✗ Git LFS is not installed, so the large files in this push cannot be uploaded. Run /onboarding."
  exit 1
fi

exit 0