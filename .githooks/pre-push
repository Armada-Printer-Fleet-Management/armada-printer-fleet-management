#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-push — runs type checks and tests before anything reaches the remote.
#
# This file only orchestrates: shared helpers live in pre-push.d/_lib.sh, and
# each service's own checks live in pre-push.d/<service>/check.sh. Add a new
# service by adding a new subdirectory there -- this dispatcher never changes.
#
# A gate applies when the code it checks exists in the repo. Once it applies it
# is mandatory: a missing tool fails the push rather than being waved through,
# so nobody pushes code they cannot verify.
#
# Deliberate bypass:  git push --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1
# shellcheck source=.githooks/pre-push.d/_lib.sh
source .githooks/pre-push.d/_lib.sh

FAILED=0
NA=()

echo "pre-push checks:"

# ── Protobuf contract (shared across every service, not per-service) ────────
if [ -f buf.yaml ]; then
  require "buf lint" buf buf lint
else
  NA+=("protobuf")
fi

# ── Per-service checks ────────────────────────────────────────────────────────
for service_dir in .githooks/pre-push.d/*/; do
  check="${service_dir}check.sh"
  if [ -f "$check" ]; then
    # shellcheck source=/dev/null
    source "$check"
  fi
done

# ── Summary ──────────────────────────────────────────────────────────────────
echo ""
if [ ${#NA[@]} -gt 0 ]; then
  dim "not applicable (no such code in repo yet): ${NA[*]}"
fi

if [ $FAILED -ne 0 ]; then
  red "✗ Push aborted."
  exit 1
fi

exit 0