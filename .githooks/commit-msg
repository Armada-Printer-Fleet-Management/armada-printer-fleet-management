#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# commit-msg — enforces the commit contract defined in AGENTS.md.
#
#   <type>(<scope>): <title>
#
#   - plain-language bullet
#   - one bullet per meaningful change
#
#   AI Use Statement          (optional; only when an agent helped)
#     Tool:     ...
#
#   PROJ-123 <Jira Ticket Title>
#
# Rejects: malformed subjects, missing ticket trailer, Co-Authored-By trailers.
# Allows:  merge commits, revert commits, and fixup!/squash! (needed for rebase).
#
# The body is unconstrained, so the AI Use Statement needs no rule of its own.
# It is deliberately not required: a commit written without an agent carries none.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

MSG_FILE="$1"
TICKET_PATTERN='^[A-Z][A-Z0-9]{1,9}-[0-9]+ .+$'
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
MAX_SUBJECT=72

red() { printf '\033[31m%s\033[0m\n' "$*"; }
dim() { printf '\033[2m%s\033[0m\n' "$*"; }

# Strip comment lines and trailing blank lines.
mapfile -t LINES < <(grep -v '^#' "$MSG_FILE" | sed -e 's/[[:space:]]*$//')
while [ ${#LINES[@]} -gt 0 ] && [ -z "${LINES[-1]}" ]; do
  unset 'LINES[-1]'
done

if [ ${#LINES[@]} -eq 0 ]; then
  red "✗ Empty commit message."
  exit 1
fi

SUBJECT="${LINES[0]}"

# ── Escape hatches ───────────────────────────────────────────────────────────
# Merge and revert subjects are generated by git, and fixup!/squash! subjects are
# consumed by rebase. None are hand-authored, so the contract does not apply.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then exit 0; fi
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

FAILED=0

# ── Rule 1: no agent attribution trailers ────────────────────────────────────
if printf '%s\n' "${LINES[@]}" | grep -qiE '^[[:space:]]*co-authored-by:'; then
  red "✗ Commit contains a Co-Authored-By trailer."
  dim "  Agent attribution trailers are not used in this repository (AGENTS.md)."
  dim "  Declare agent use with an AI Use Statement in the body instead."
  dim "  Remove the line and commit again."
  FAILED=1
fi

# ── Rule 2: conventional subject ─────────────────────────────────────────────
if ! printf '%s' "$SUBJECT" | grep -qE "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+$"; then
  red "✗ Subject line is not a conventional commit."
  dim "  Got:      $SUBJECT"
  dim "  Expected: <type>(<scope>): <title>"
  dim "  Types:    $TYPES"
  FAILED=1
elif [ ${#SUBJECT} -gt $MAX_SUBJECT ]; then
  red "✗ Subject line is ${#SUBJECT} characters (max $MAX_SUBJECT)."
  dim "  $SUBJECT"
  FAILED=1
fi

# ── Rule 3: blank line after subject ─────────────────────────────────────────
if [ ${#LINES[@]} -gt 1 ] && [ -n "${LINES[1]}" ]; then
  red "✗ Line 2 must be blank (separates subject from body)."
  FAILED=1
fi

# ── Rule 4: Jira ticket trailer on the last line ─────────────────────────────
if [ ${#LINES[@]} -eq 1 ]; then
  red "✗ Commit is missing the Jira ticket trailer."
  dim "  Expected a final line like: PROJ-123 Add printer status polling"
  FAILED=1
else
  TRAILER="${LINES[-1]}"
  if ! printf '%s' "$TRAILER" | grep -qE "$TICKET_PATTERN"; then
    red "✗ Last line must be the Jira ticket ID and title."
    dim "  Got:      $TRAILER"
    dim "  Expected: PROJ-123 Add printer status polling"
    FAILED=1
  elif [ -n "${LINES[-2]}" ]; then
    red "✗ Ticket trailer must be preceded by a blank line."
    FAILED=1
  fi
fi

if [ $FAILED -ne 0 ]; then
  echo ""
  dim "─────────────────────────────────────────────────────────"
  dim "Expected format:"
  dim ""
  dim "  feat(printer): add Moonraker status polling"
  dim ""
  dim "  - Poll printer state every 5 seconds"
  dim "  - Surface offline printers in the job list"
  dim ""
  dim "  PROJ-123 Add printer status polling"
  dim "─────────────────────────────────────────────────────────"
  dim "Run /commit-message to generate a compliant message."
  exit 1
fi

exit 0
