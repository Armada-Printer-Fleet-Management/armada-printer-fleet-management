# ═════════════════════════════════════════════════════════════════════════════════════════════════
# Example settings for the deployment stack, infra/deploy/compose.yaml
# ═════════════════════════════════════════════════════════════════════════════════════════════════
#
# This file is documentation only. It is committed, and Docker Compose never reads it.
#
# The real settings are in config/compose.deploy.env, which is gitignored. It is made in one of
# two ways, whichever happens first:
#
#   1. /onboarding copies this file to config/compose.deploy.env, REPLACE_ME values and all.
#   2. scripts/compose_run.py creates config/compose.deploy.env if it does not exist yet.
#
# Then, every time it runs, scripts/compose_run.py fills in each value marked "Generated" that is
# missing or still REPLACE_ME, writes any value given with --domain or --admin-email, and passes
# the file to Docker Compose. It never changes a generated value that is already filled in: each
# container stores its value on its first start, so a new one would lock the stack out of its own
# data. Do not edit generated values by hand.
#
#   Required   the script refuses to start until it is set; pass it as a flag once
#   Generated  filled in by scripts/compose_run.py; leave as REPLACE_ME
#   Default    filled in by scripts/compose_run.py if missing; safe to change
#
# This file is for running the deployment stack locally or on a test machine. A real installation
# keeps the same settings in its own .env file, written by its installer.


# ─── web: Caddy and the built frontend ────────────────────────────────────────────────────────────

# Required. The address Caddy serves. A real domain that points at this machine gets an HTTPS
# certificate automatically; ":80" serves plain HTTP, for a test machine without DNS.
# Set with --domain.
DOMAIN=REPLACE_ME

# Required. Contact address for certificate expiry notices. Set with --admin-email.
ADMIN_EMAIL=REPLACE_ME


# ─── web and server: which images to run ──────────────────────────────────────────────────────────

# Default. The images are ghcr.io/<GHCR_OWNER>/armada-web:<VERSION> and armada-server:<VERSION>.
# Until a registry is published, scripts/compose_run.py builds them locally under these tags.
GHCR_OWNER=local
VERSION=dev


# ─── db: Postgres ─────────────────────────────────────────────────────────────────────────────────

# Generated. Password for the armada user. Not reachable from outside the stack.
DB_PASSWORD=REPLACE_ME


# ─── garage-s3-storage: Garage ────────────────────────────────────────────────────────────────────

# Generated. Garage's internal secret, used only between Garage and its own admin tool.
GARAGE_RPC_SECRET=REPLACE_ME

# Generated. The S3 access key: the username the server uses for the bucket. Not reachable
# from outside the stack.
GARAGE_DEFAULT_ACCESS_KEY=REPLACE_ME

# Generated. The S3 secret key: the password that goes with the access key.
GARAGE_DEFAULT_SECRET_KEY=REPLACE_ME

# Default. The bucket Garage creates on first start.
GARAGE_DEFAULT_BUCKET=armada
