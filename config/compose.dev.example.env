# ═════════════════════════════════════════════════════════════════════════════════════════════════
# Example settings for the development stack, infra/dev/compose.yaml
# ═════════════════════════════════════════════════════════════════════════════════════════════════
#
# This file is documentation only. It is committed, and Docker Compose never reads it.
#
# The real settings are in config/compose.dev.env, which is gitignored. It is made in one of two
# ways, whichever happens first:
#
#   1. /onboarding copies this file to config/compose.dev.env, REPLACE_ME values and all.
#   2. scripts/compose_run.py creates config/compose.dev.env if it does not exist yet.
#
# Then, every time it runs, scripts/compose_run.py fills in each value marked "Generated" that is
# missing or still REPLACE_ME, and passes the file to Docker Compose. It never changes a value
# that is already filled in: each container stores its value on its first start, so a new one
# would lock the stack out of its own data. Do not edit generated values by hand.
#
#   Generated  filled in by scripts/compose_run.py; leave as REPLACE_ME
#   Default    filled in by scripts/compose_run.py if missing; safe to change
#   Optional   commented out; uncomment or add it only if you need it


# ─── db: Postgres ─────────────────────────────────────────────────────────────────────────────────

# Generated. Password for the armada user. Reachable from this machine at localhost:5432.
DB_PASSWORD=REPLACE_ME

# Optional. The localhost port Postgres is published on. Set it if 5432 is already taken, for
# example by a Postgres installed natively on this machine.
# DB_PORT=5433


# ─── garage-s3-storage: Garage ────────────────────────────────────────────────────────────────────

# Generated. Garage's internal secret, used only between Garage and its own admin tool.
GARAGE_RPC_SECRET=REPLACE_ME

# Generated. The S3 access key: the username applications use for the bucket. Reachable from
# this machine at http://localhost:3900.
GARAGE_DEFAULT_ACCESS_KEY=REPLACE_ME

# Generated. The S3 secret key: the password that goes with the access key.
GARAGE_DEFAULT_SECRET_KEY=REPLACE_ME

# Default. The bucket Garage creates on first start.
GARAGE_DEFAULT_BUCKET=armada
