#!/usr/bin/env bash
# The armada command: everything an operator does to an Armada installation after install.sh has
# set it up. Installed to /usr/local/bin/armada, and replaced by each successful update with that
# version's copy. Run `armada help` for the commands.
#
# Never add `docker compose down -v` here: it deletes the database, the stored files and Caddy's
# certificates. Only `uninstall --delete-data` removes volumes, by name, after a typed confirmation.
set -euo pipefail

ARMADA_HOME="${ARMADA_HOME:-/opt/armada}"
ENV_FILE="$ARMADA_HOME/.env"
STATE_FILE="$ARMADA_HOME/state.env"
RELEASES="$ARMADA_HOME/releases"
BIN=/usr/local/bin/armada
UNIT_DIR=/etc/systemd/system
TIMER=armada-update.timer
SERVICE=armada-update.service
LOCK_FILE=/run/armada.lock
HEALTH_TIMEOUT="${ARMADA_HEALTH_TIMEOUT:-600}"
MIGRATION_SECONDS="${ARMADA_MIGRATION_TIMEOUT:-600}"
RUN_LOG="$ARMADA_HOME/last-run.log"

# Compose settings must come from the installation's .env only. A variable of the same name in the
# caller's shell would otherwise override it.
unset VERSION REGISTRY GHCR_OWNER IMAGE_SUFFIX DOMAIN ADMIN_EMAIL

# ── output ───────────────────────────────────────────────────────────────────────────────────────

# Colour only for a person at a terminal, so the timer's journal and captured output stay plain.
colour() { [ -t "$1" ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; }
if colour 1; then
  # Bright blue, since plain blue is hard to read on a dark background.
  BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[31m' GREEN=$'\e[32m' YELLOW=$'\e[33m' BLUE=$'\e[94m' RESET=$'\e[0m'
else
  BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" RESET=""
fi
heading() { printf '%s%s%s' "$BOLD$BLUE" "$1" "$RESET"; }
if colour 2; then ERR_YELLOW=$'\e[33m' ERR_RED=$'\e[31m' ERR_RESET=$'\e[0m'; else ERR_YELLOW="" ERR_RED="" ERR_RESET=""; fi

say() { printf '%s\n' "$*"; }
warn() { printf '%sarmada: %s%s\n' "$ERR_YELLOW" "$*" "$ERR_RESET" >&2; }
die() {
  printf '%sarmada: %s%s\n' "$ERR_RED" "$*" "$ERR_RESET" >&2
  exit 1
}

# Tracks are internal on production, so they are listed only on preview machines. help runs
# without root, and .env is readable by root only, so an unreadable one hides them.
track_key() { [ -r "$ENV_FILE" ] && preview_track && printf ' track,'; }

usage() {
  local track
  track=$(track_key || true)
  cat <<EOF
Usage: armada <command> [arguments]

$(heading Versions)
  update <version|latest> [--force]
                              Move to a version; latest is the newest available to this machine.
                              Migrates the database first. Returns to the previous version if the
                              new one does not start, unless that version cannot read the new
                              database schema.
  rollback [version] [--yes] [--force]
                              Return to the version before the last update, or to the version
                              given, after asking. Run it again to undo the rollback.
                              Versions that cannot read the database schema are refused; --force
                              moves to one anyway, after the database has been restored to suit it.
  check-for-updates           Say whether a newer version is available
  version                     Print the running version

$(heading Running)
  status                      What is running and whether it is healthy
  logs [service] [lines]      Follow the logs, of every service or just one
  restart                     Restart every service
  stop                        Stop every service; data is kept
  start                       Start every service again

$(heading Settings)
  reconfigure                 Answer the installation questions again
  config <key> [value]        Show one setting, or change it when a value is given:
                                domain, admin-email,${track} update-policy,
                                update-window, update-interval
  uninstall [--delete-data] [--yes]
                              Remove Armada. Data is kept unless --delete-data is given.
  help                        Show this list

$(heading "Time limits, in seconds, for update, rollback, start and restart")
  ARMADA_MIGRATION_TIMEOUT    How long the database migration may take (default 600)
  ARMADA_HEALTH_TIMEOUT       How long the services may take to become healthy after it (default 600)

Docker's output from the last update, rollback, start, restart or stop is kept in $RUN_LOG.
EOF
}

# ── settings files: KEY=VALUE lines, never sourced ───────────────────────────────────────────────

get_kv() {
  local file=$1 key=$2 default=${3:-} value=""
  [ -f "$file" ] && value=$(sed -n "s/^$key=//p" "$file" | tail -n 1)
  printf '%s' "${value:-$default}"
}

# Rewrites one key in place, keeping every other line. mktemp creates the file readable by root
# only, which matters because .env holds the generated passwords.
set_kv() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp "$file.XXXXXX")
  touch "$file"
  KEY=$key VALUE=$value awk '
    index($0, ENVIRON["KEY"] "=") == 1 { if (!done) print ENVIRON["KEY"] "=" ENVIRON["VALUE"]; done = 1; next }
    { print }
    END { if (!done) print ENVIRON["KEY"] "=" ENVIRON["VALUE"] }
  ' "$file" >"$tmp"
  mv -f "$tmp" "$file"
}

setting() { get_kv "$ENV_FILE" "$@"; }
set_setting() { set_kv "$ENV_FILE" "$@"; }
state() { get_kv "$STATE_FILE" "$@"; }
set_state() { set_kv "$STATE_FILE" "$@"; }

# ── validation ───────────────────────────────────────────────────────────────────────────────────

# A production version, a release candidate, or a build from main.
valid_version() { [[ $1 =~ ^([0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?|sha-[0-9a-f]{12})$ ]]; }
valid_track() { [[ $1 =~ ^(production|staging|testing)$ ]]; }
# Testing and staging come from the private preview packages; production from the public ones.
preview_track() { [ "${1:-$(setting TRACK production)}" != production ]; }
valid_policy() { [[ $1 =~ ^(notify|auto|off)$ ]]; }
valid_window() { [ -z "$1" ] || [[ $1 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; }
valid_interval() { [[ $1 =~ ^[0-9a-z\ ]+$ ]] && systemd-analyze timespan "$1" >/dev/null 2>&1; }
# ":80" serves plain HTTP; otherwise a host name.
valid_domain() { [[ $1 =~ ^(:[0-9]+|[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?)$ ]]; }
valid_email() { [[ $1 =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]]; }

# Quotes the value, so an empty or space-filled answer is visible in the message.
not_valid() { die "'$1' is not a valid $2. $3"; }

check_value() {
  local key=$1 value=$2
  case "$key" in
    domain) valid_domain "$value" || not_valid "$value" "domain name" "Use a host name such as armada.example.com, or :80 for plain HTTP." ;;
    admin-email) valid_email "$value" || not_valid "$value" "email address" "Use one like name@example.com." ;;
    track) valid_track "$value" || not_valid "$value" track "Use production, staging or testing." ;;
    update-policy) valid_policy "$value" || not_valid "$value" "update policy" "Use notify, auto or off." ;;
    update-window) valid_window "$value" || not_valid "$value" "update window" "Use 24-hour times like 02:00-05:00, or leave it empty for any time." ;;
    update-interval) valid_interval "$value" || not_valid "$value" "update interval" "Use a time span such as 6h or 15min." ;;
    *) not_valid "$key" setting "Run armada help." ;;
  esac
}

setting_key() {
  case "$1" in
    domain) echo DOMAIN ;;
    admin-email) echo ADMIN_EMAIL ;;
    track) echo TRACK ;;
    update-policy) echo UPDATE_POLICY ;;
    update-window) echo UPDATE_WINDOW ;;
    update-interval) echo UPDATE_INTERVAL ;;
    *) not_valid "$1" setting "Run armada help." ;;
  esac
}

# Whether now is inside an HH:MM-HH:MM window, which may cross midnight. No window means always.
in_window() {
  local window=$1 now start end
  [ -z "$window" ] && return 0
  now=$((10#$(date +%H%M)))
  start=$((10#${window:0:2}${window:3:2}))
  end=$((10#${window:6:2}${window:9:2}))
  if [ "$start" -le "$end" ]; then
    [ "$now" -ge "$start" ] && [ "$now" -lt "$end" ]
  else
    [ "$now" -ge "$start" ] || [ "$now" -lt "$end" ]
  fi
}

# ── docker compose ───────────────────────────────────────────────────────────────────────────────

# Each version runs from its own release directory. The project name is fixed in compose.yaml, so
# the volumes are the same whichever version runs.
compose_at() {
  local version=$1
  shift
  # The migrate service's health check allows a migration this long, the same limit bring_up
  # waits for.
  MIGRATION_TIMEOUT="${MIGRATION_SECONDS}s" docker compose --project-directory "$RELEASES/$version" \
    -f "$RELEASES/$version/compose.yaml" --env-file "$ENV_FILE" "$@"
}

compose() {
  local version
  version=$(setting VERSION)
  [ -n "$version" ] || die "No version is installed yet. Run: armada update latest"
  compose_at "$version" "$@"
}

# migrate is a step that runs on every start, not a service: a reboot leaves it stopped, so it is
# left out here and waited for by bring_up instead. Every other service declares a
# health check, so the stack is up when all of them report healthy.
all_healthy() {
  local expected lines
  expected=$(compose config --services | grep -cvx migrate)
  lines=$(compose ps --all --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null) || return 1
  [ "$(grep -v '^migrate ' <<<"$lines" | grep -c ' running healthy$')" -eq "$expected" ]
}

# Where the database migration of the running version stands: none (the version has no migrate
# step), migrating, migrated, timed-out, failed, or stopped (ended by a stop or reboot after it had
# run; the schema it applied stays).
migration_state() {
  local services line state health code
  # Captured first: grep -q on a pipe can stop the writer mid-output and fail the pipeline.
  services=$(compose config --services)
  grep -qx migrate <<<"$services" || { printf none; return 0; }
  # Separated by |, because an exited container has an empty health column.
  line=$(compose ps --all --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}' 2>/dev/null |
    grep '^migrate|' || true)
  IFS='|' read -r _ state health code <<<"$line"
  migration_from "$state" "$health" "$code"
}

# The same, from the migrate container's state, health and exit code as compose ps reports them.
migration_from() {
  case "$1 $2" in
    "running healthy") printf migrated ;;
    "running unhealthy") printf timed-out ;;
    running* | restarting* | created* | " ") printf migrating ;;
    *)
      # A signal's exit code (128 + signal) means it was stopped, not that the migration failed.
      if [ "${3:-1}" -ge 128 ]; then printf stopped; else printf failed; fi
      ;;
  esac
}

# ── progress ─────────────────────────────────────────────────────────────────────────────────────

# Docker's own output goes to the run log rather than the screen. Each command that changes the
# stack starts it afresh, and a failure prints its end.
begin_run_log() { : >"$RUN_LOG"; }
quietly() { "$@" >>"$RUN_LOG" 2>&1; }
show_run_log() {
  [ -s "$RUN_LOG" ] || return 0
  warn "Docker's output (last 20 lines; all of it in $RUN_LOG):"
  tail -n 20 "$RUN_LOG" | sed 's/^/  /' >&2
}

# A short step with nothing to measure, such as stopping.
quiet_step() {
  local label=$1
  shift
  printf '%s... ' "$label"
  if quietly "$@"; then
    say "done"
    return 0
  fi
  say failed
  show_run_log
  return 1
}

# Redrawing in place needs a terminal. It is decided apart from colour, so NO_COLOR keeps it.
redraw() { [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; }
utf8() { [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} =~ [Uu][Tt][Ff]-?8 ]]; }
clock() { printf '%d:%02d' $(($1 / 60)) $(($1 % 60)); }

service_label() {
  case "$1" in
    migrate) echo "Database migration" ;;
    db) echo Database ;;
    garage-s3-storage) echo "File storage" ;;
    keycloak-db) echo "Sign-in database" ;;
    keycloak) echo Sign-in ;;
    server) echo "Application server" ;;
    web) echo "Web server" ;;
    *) echo "$1" ;;
  esac
}

# The word for how far a service has got: migrate has two stages, every other service three.
stage_word() {
  if [ "$1" = migrate ]; then
    if [ "$2" -ge 2 ]; then echo "done"; else echo migrating; fi
    return 0
  fi
  case "$2" in
    1) echo created ;;
    2) echo starting ;;
    *) echo healthy ;;
  esac
}

# 100 parts in 50 cells: a full cell is 2%, and a half cell shows an odd percentage.
bar() {
  local pct=$1 colour=$2 fill="█" half="▌" cells="" i
  utf8 || { fill="#" half="-"; }
  for ((i = 0; i < pct / 2; i++)); do cells+=$fill; done
  [ $((pct % 2)) -eq 1 ] && cells+="$half"
  printf '[%s%s%s%*s]' "$colour" "$cells" "$RESET" $((50 - pct / 2 - pct % 2)) ""
}

# Away from a terminal, each change is one line.
progress_line() { printf '  %3d%%  %s\n' "$1" "$2"; }

# Rows mark a spinner with this byte. The list is rebuilt once a second, but paint swaps the
# spinner in 20 times a second with builtins only, so a weak machine is not loaded by it.
SPIN=$'\x01'
TICKS_PER_SECOND=20 # paired with the 0.05s sleep in progress_pause
TICK=0
spinner() { printf '%s' "$SPIN"; }

# One row of the list. Colour is applied after padding, which would otherwise count its codes.
#   step_row <colour> <icon> <label> <word> <time> <note>
step_row() {
  printf '   %s%s%s %-*s  %s%-11s%s  %s%5s%s' "$1" "$2" "$RESET" "$width" "$3" "$1" "$4" "$RESET" \
    "$DIM" "$5" "$RESET"
  [ -z "$6" ] || printf '  %s%s%s' "$DIM" "$6" "$RESET"
  printf '\n'
}

# The list under the bar, one row per step, read from bring_up's variables. Unfinished steps are
# yellow and finished ones green. After a failure, the steps that failed are red and the ones it
# kept from starting are dim.
step_rows() {
  local service n colour icon word time note ok=✔ bad=✘ idle=·
  utf8 || { ok=+ bad=x idle=-; }
  if $download; then
    if [ "$downloaded" -eq 1 ]; then
      step_row "$GREEN" "$ok" Download "done" "$(clock "$download_took")" ""
    elif [ "$BRING_UP_FAILED" = download ]; then
      step_row "$RED" "$bad" Download failed "$(clock $((SECONDS - begin)))" ""
    else
      step_row "$YELLOW" "$(spinner)" Download downloading "$(clock $((SECONDS - begin)))" ""
    fi
  fi
  for service in "${list[@]}"; do
    n=${count[$service]} note="" time=""
    [ "$n" -gt 0 ] && time=$(clock $((SECONDS - since[$service])))
    if [ "$n" -ge "${full[$service]}" ]; then
      colour=$GREEN icon=$ok word=$(stage_word "$service" "$n") time=$(clock "${took[$service]}")
    elif [ "$BRING_UP_FAILED" = migration ] && [ "$service" = migrate ]; then
      colour=$RED icon=$bad word=failed
    elif [[ $BRING_UP_FAILED =~ ^(health|start)$ ]]; then
      colour=$RED icon=$bad word="not healthy"
    elif [ -n "$BRING_UP_FAILED" ]; then
      colour=$DIM icon=$idle word="not started"
      [ "$n" -eq 0 ] || word=$(stage_word "$service" "$n")
    elif [ "$n" -eq 0 ]; then
      colour=$YELLOW icon=$idle word=waiting
    else
      colour=$YELLOW icon=$(spinner) word=$(stage_word "$service" "$n")
      [ $((SECONDS - since[$service])) -ge 60 ] && note="first start is slow"
    fi
    step_row "$colour" "$icon" "$(service_label "$service")" "$word" "$time" "$note"
  done
}

# Replaces the last frame on a terminal: the bar, the list and, at the end, the outcome.
PROGRESS_LINES=0
FRAME_ROWS=()
draw_frame() {
  local pct=$1 outcome=${2:-} line
  FRAME_ROWS=("  $(bar "$pct" "$GREEN")  $BOLD$(printf '%3d%%' "$pct")$RESET  $DIM$(clock $((SECONDS - begin)))$RESET")
  while IFS= read -r line; do FRAME_ROWS+=("$line"); done < <(step_rows)
  [ -z "$outcome" ] || FRAME_ROWS+=("" "  $outcome")
  paint
}

# Prints the frame over the last one, with the spinners at the current tick. Any frame count
# makes two full turns a second.
paint() {
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏) line
  utf8 || frames=('|' / - "\\")
  local n=${#frames[@]} now=$((TICK * 1000000 / TICKS_PER_SECOND))
  # Bash 5's clock, in microseconds, keeps the speed whatever rate the frames are drawn at.
  [ -z "${EPOCHREALTIME:-}" ] || now=$((10#${EPOCHREALTIME//[.,]/} % 1000000000))
  local glyph=${frames[now * 2 * n / 1000000 % n]}
  [ "$PROGRESS_LINES" -eq 0 ] || printf '\e[%dA' "$PROGRESS_LINES"
  for line in "${FRAME_ROWS[@]}"; do printf '\r\e[2K%s\n' "${line//"$SPIN"/$glyph}"; done
  PROGRESS_LINES=${#FRAME_ROWS[@]}
}

# Waits about a second before the next poll, turning the spinners meanwhile on a terminal.
progress_pause() {
  local i
  if ! redraw; then
    sleep 1
    return 0
  fi
  for ((i = 0; i < TICKS_PER_SECOND; i++)); do
    sleep 0.05
    TICK=$((TICK + 1))
    paint
  done
}

# The services in list that have not finished, by name, for a failure message.
unfinished() {
  local service names=()
  for service in "${list[@]}"; do
    [ "${count[$service]}" -lt "${full[$service]}" ] && names+=("$(service_label "$service")")
  done
  local IFS=,
  printf '%s' "${names[*]}" | sed 's/,/, /g'
}

# An image reference without Docker Hub's implied prefix, so either spelling matches.
image_name() {
  local name=${1#docker.io/}
  printf '%s' "${name#library/}"
}

# Brings a version up and shows one bar for it until every service is healthy. The bar counts
# stages: the download when there is one, the migration's two and every other service's three.
# The compose command runs in the background, because up does not return until the services
# others depend on are healthy, the migration included. With a download, VERSION is set to the
# version once its images are here, so a failed download leaves the installation as it was.
#   bring_up <version> <download: true|false> <compose command...>
# BRING_UP_FAILED says what failed: download, migration, start or health.
BRING_UP_FAILED=""
bring_up() {
  local version=$1 download=$2
  shift 2
  local services service state health code n total=0 reached=0 downloaded=0 download_took=0 pct=0
  local job status=0 phase=start begin=$SECONDS migration_deadline=0 health_deadline=0 beat=$SECONDS
  local failed="" activity elapsed outcome=1 more width=8 label
  local -a list=() changed=() waiting=()
  local -A count=() full=() since=() took=() row=() wanted=()
  local image
  BRING_UP_FAILED=""
  PROGRESS_LINES=0

  # A container still running another version's image is about to be replaced, so it counts for
  # nothing while the compose command runs; otherwise an update would count the old server as
  # healthy, then drop it back as it is replaced. Once the command ends every container is this
  # version's, so the rule is lifted then, and an image named two ways cannot stall the bar.
  while read -r image; do
    [ -z "$image" ] || wanted[$(image_name "$image")]=1
  done < <(release_images "$version" || true)

  services=$(VERSION=$version compose_at "$version" config --services) || return 1
  if grep -qx migrate <<<"$services"; then list+=(migrate); fi
  while read -r service; do
    if [ -n "$service" ] && [ "$service" != migrate ]; then list+=("$service"); fi
  done <<<"$services"
  for service in "${list[@]}"; do
    count[$service]=0
    full[$service]=3
    [ "$service" = migrate ] && full[$service]=2
    total=$((total + full[$service]))
    label=$(service_label "$service")
    [ ${#label} -gt "$width" ] && width=${#label}
  done
  if $download; then
    phase=download
    total=$((total + 1))
  fi

  say "$(heading "Starting Armada $version")"
  if redraw; then
    printf '\e[?25l'
    trap 'printf "\e[?25h"' EXIT
    say ""
  fi
  if [ "$phase" = download ]; then
    VERSION=$version quietly compose_at "$version" pull --quiet &
  else
    VERSION=$version quietly compose_at "$version" "$@" &
    migration_deadline=$((SECONDS + MIGRATION_SECONDS))
  fi
  job=$!

  while :; do
    changed=()
    if [ "$phase" = start ]; then
      row=()
      while IFS='|' read -r service state health code image; do
        [ -n "$service" ] || continue
        if [ -n "$job" ] && [ ${#wanted[@]} -gt 0 ] && [ -z "${wanted[$(image_name "$image")]:-}" ]; then
          continue
        fi
        row[$service]="$state|$health|$code"
      done < <(VERSION=$version compose_at "$version" ps --all \
        --format '{{.Service}}|{{.State}}|{{.Health}}|{{.ExitCode}}|{{.Image}}' 2>/dev/null || true)
      for service in "${list[@]}"; do
        n=0
        if [ -n "${row[$service]:-}" ]; then
          IFS='|' read -r state health code <<<"${row[$service]}"
          if [ "$service" = migrate ]; then
            case "$(migration_from "$state" "$health" "$code")" in
              migrated) n=2 ;;
              migrating) n=1 ;;
              failed)
                n=${count[$service]}
                failed="Database migration"
                BRING_UP_FAILED=migration
                ;;
              timed-out)
                n=${count[$service]}
                failed="Database migration, which took too long"
                BRING_UP_FAILED=migration
                ;;
            esac
          else
            case "$state $health" in
              "running healthy") n=3 ;;
              "running starting") n=2 ;;
              created*) n=1 ;;
              # Unhealthy, restarting or exited: it keeps the stages it reached.
              *) n=${count[$service]} ;;
            esac
          fi
        fi
        [ "$n" -gt 0 ] && [ -z "${since[$service]:-}" ] && since[$service]=$SECONDS
        [ "$n" -gt "${count[$service]}" ] && changed+=("$service")
        if [ "$n" -ge "${full[$service]}" ]; then
          [ -n "${took[$service]:-}" ] || took[$service]=$((SECONDS - since[$service]))
        else
          unset "took[$service]"
        fi
        count[$service]=$n
      done
    fi

    if [ -n "$job" ] && ! kill -0 "$job" 2>/dev/null; then
      if wait "$job"; then status=0; else status=$?; fi
      job=""
      if [ "$phase" = download ]; then
        if [ "$status" -ne 0 ]; then
          failed="Downloading $version"
          BRING_UP_FAILED=download
        else
          downloaded=1
          download_took=$((SECONDS - begin))
          changed+=(download)
          set_setting VERSION "$version"
          phase=start
          VERSION=$version quietly compose_at "$version" "$@" &
          job=$!
          migration_deadline=$((SECONDS + MIGRATION_SECONDS))
        fi
      elif [ "$status" -ne 0 ] && [ -z "$failed" ]; then
        failed=$(unfinished)
        BRING_UP_FAILED=start
      fi
    fi

    reached=$downloaded
    for service in "${list[@]}"; do reached=$((reached + count[$service])); done
    pct=$((100 * reached / total))

    # Away from a terminal each change is printed now, before the checks below can end the loop,
    # so the stages reached on the last poll are not lost.
    if ! redraw; then
      for service in "${changed[@]}"; do
        if [ "$service" = download ]; then
          printf '  %3d%%  Downloaded %s (%s)\n' "$pct" "$version" "$(clock $((SECONDS - begin)))"
        else
          printf '  %3d%%  %s: %s (%s)\n' "$pct" "$(service_label "$service")" \
            "$(stage_word "$service" "${count[$service]}")" \
            "$(clock "${took[$service]:-$((SECONDS - since[$service]))}")"
        fi
        beat=$SECONDS
      done
    fi

    # The services get their limit only once the migration is done, as it may take far longer.
    if [ "$phase" = start ] && [ "$health_deadline" -eq 0 ] &&
      { [ -z "${count[migrate]+set}" ] || [ "${count[migrate]}" -ge 2 ]; }; then
      health_deadline=$((SECONDS + HEALTH_TIMEOUT))
    fi
    if [ -z "$failed" ] && [ "$phase" = start ]; then
      if [ -z "$job" ] && [ "$reached" -eq "$total" ]; then
        outcome=0
        break
      fi
      if [ "$health_deadline" -eq 0 ] && [ "$SECONDS" -ge "$migration_deadline" ]; then
        failed="Database migration, which took too long"
        BRING_UP_FAILED=migration
      elif [ "$health_deadline" -gt 0 ] && [ "$SECONDS" -ge "$health_deadline" ]; then
        failed=$(unfinished)
        BRING_UP_FAILED=health
      fi
    fi
    [ -z "$failed" ] || break

    waiting=()
    for service in "${list[@]}"; do
      if [ "${count[$service]}" -gt 0 ] && [ "${count[$service]}" -lt "${full[$service]}" ]; then
        waiting+=("$service")
      fi
    done
    if [ "$phase" = download ]; then
      activity="${YELLOW}Downloading${RESET} $version"
    elif [ ${#waiting[@]} -gt 0 ]; then
      service=${waiting[0]}
      elapsed=$((SECONDS - since[$service]))
      more=""
      [ ${#waiting[@]} -gt 1 ] && more=", and $((${#waiting[@]} - 1)) more"
      activity="${YELLOW}Waiting for:${RESET} $(service_label "$service") ${DIM}($(clock "$elapsed")"
      [ "$elapsed" -ge 60 ] && activity+=", first start can take several minutes"
      activity+=")${RESET}$more"
    else
      activity="${YELLOW}Starting services${RESET}"
    fi

    if redraw; then
      draw_frame "$pct"
    elif [ $((SECONDS - beat)) -ge 30 ]; then
      progress_line "$pct" "$activity"
      beat=$SECONDS
    fi
    progress_pause
  done

  # A compose command still running when the wait gives up is stopped, children first.
  if [ -n "$job" ]; then
    pkill -TERM -P "$job" 2>/dev/null || true
    kill "$job" 2>/dev/null || true
    wait "$job" 2>/dev/null || true
  fi
  elapsed=$((SECONDS - begin))
  if [ "$outcome" -eq 0 ]; then
    activity="${GREEN}Ready${RESET} ${DIM}($(clock "$elapsed"))${RESET}"
  else
    activity="${RED}Failed:${RESET} ${failed:-Docker did not finish starting Armada}"
  fi
  if redraw; then
    draw_frame "$pct" "$activity"
    printf '\e[?25h'
    trap - EXIT
  else
    progress_line "$pct" "$activity"
  fi
  return "$outcome"
}

# What to try when a version did not become healthy, from how its migration ended.
not_healthy_hint() {
  local version=$1
  case "$(migration_state)" in
    failed) say "The database migration failed. See why: armada logs migrate" ;;
    migrating | timed-out) say "The database migration did not finish in time. If it only needs longer, allow it: sudo ARMADA_MIGRATION_TIMEOUT=1800 armada update $version" ;;
    *) say "If the machine is only slow to start, allow it longer: sudo ARMADA_HEALTH_TIMEOUT=1200 armada update $version" ;;
  esac
}

image_ref() {
  printf '%s/%s/%s%s:%s' "$(setting REGISTRY ghcr.io)" "$(setting GHCR_OWNER)" "$1" \
    "$(setting IMAGE_SUFFIX)" "$2"
}

# Copies /release out of a preview release image into a directory. The image has no shell, so it
# is created with a placeholder command and never started. Once copied it is removed, since every
# check would otherwise leave one behind; it is a few kilobytes to pull again.
extract_release_image() {
  local tag=$1 out=$2 ref container status=0
  ref=$(image_ref armada-release "$tag")
  docker pull --quiet "$ref" >/dev/null || return 1
  container=$(docker create "$ref" none) || return 1
  docker cp "$container:/release/." "$out" || status=$?
  docker rm "$container" >/dev/null
  docker image rm "$ref" >/dev/null 2>&1 || true
  return "$status"
}

# GitHub serves the newest full release's files under releases/latest/download.
latest_url() {
  local url
  url=$(setting RELEASE_URL)
  printf '%s/latest/download' "${url%/download}"
}

# The version a track's pointer names. Preview tracks read it from the release image the pointer
# is on; production reads it from the latest GitHub release.
track_version() {
  local track version tmp
  track=$(setting TRACK production)
  if preview_track "$track"; then
    tmp=$(mktemp -d)
    extract_release_image "$track" "$tmp" || {
      rm -rf "$tmp"
      die "Could not read $(image_ref armada-release "$track"). Is this machine logged in? docker login $(setting REGISTRY ghcr.io)"
    }
    version=$(head -n 1 "$tmp/VERSION" 2>/dev/null || true)
    rm -rf "$tmp"
  else
    version=$(curl -fsSL --retry 3 "$(latest_url)/VERSION" | head -n 1) ||
      die "Could not find the latest release at $(setting RELEASE_URL)."
  fi
  if ! valid_version "$version"; then
    preview_track "$track" && die "The $track track does not name a version."
    die "The latest release does not name a version."
  fi
  printf '%s' "$version"
}

# ── releases ─────────────────────────────────────────────────────────────────────────────────────

# Downloads every file a GitHub release lists in its SHA256SUMS.
download_release() {
  local version=$1 tmp=$2 url name
  url="$(setting RELEASE_URL)/v$version"
  curl -fsSL --retry 3 -o "$tmp/SHA256SUMS" "$url/SHA256SUMS" ||
    die "Could not download version $version from $url."
  while read -r _ name; do
    name=${name#\*} # some sha256sum builds mark binary mode with a leading *
    if ! [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || ! curl -fsSL --retry 3 -o "$tmp/$name" "$url/$name"; then
      die "Could not download $name for version $version."
    fi
  done <"$tmp/SHA256SUMS"
}

# Gets a version's files from its channel and checks them all before keeping any.
fetch_release() {
  local version=$1 dir="$RELEASES/$1" tmp
  [ -f "$dir/SHA256SUMS" ] && return 0
  mkdir -p "$RELEASES"
  tmp=$(mktemp -d "$RELEASES/.download.XXXXXX")
  if preview_track; then
    extract_release_image "$version" "$tmp" || {
      rm -rf "$tmp"
      die "Could not read $(image_ref armada-release "$version")."
    }
  # A subshell, so a failed download still removes the half-made directory; its die has already
  # said why.
  elif ! (download_release "$version" "$tmp"); then
    rm -rf "$tmp"
    exit 1
  fi
  if ! (cd "$tmp" && sha256sum --quiet --strict -c SHA256SUMS); then
    rm -rf "$tmp"
    die "Version $version failed its checksum check. Nothing was changed."
  fi
  chmod 755 "$tmp"
  mv "$tmp" "$dir"
}

# Installs a release's own command and timer units, so tooling always matches the running version.
install_tooling() {
  local dir="$RELEASES/$1"
  install -m 0755 "$dir/armada" "$BIN.new"
  mv -f "$BIN.new" "$BIN"
  install -m 0644 "$dir/$SERVICE" "$dir/$TIMER" "$UNIT_DIR/"
  systemctl daemon-reload
  systemctl enable --now "$TIMER" >/dev/null 2>&1 || warn "Could not start the update timer."
}

# The number of non-additive migrations a version's schema has been through. A release from before
# the count was shipped has none.
schema_epoch() {
  local epoch
  epoch=$(head -n 1 "$RELEASES/$1/SCHEMA_EPOCH" 2>/dev/null || true)
  [[ $epoch =~ ^[0-9]+$ ]] || epoch=0
  printf '%s' "$epoch"
}

# True when moving from one fetched version to another crosses a non-additive migration, so the
# second cannot read the first one's schema.
downgrade_blocked() {
  [ "$(schema_epoch "$2")" -lt "$(schema_epoch "$1")" ]
}

# The images a version's compose.yaml names, one per line.
release_images() {
  VERSION=$1 compose_at "$1" config --images 2>/dev/null
}

# Keeps the running and previous versions' files and images; older ones are downloaded again if
# needed. Only images an older version names, and no kept one, are removed.
prune_releases() {
  local keep_current keep_previous kept="" version dir image
  keep_current=$(setting VERSION)
  keep_previous=$(state PREVIOUS_VERSION)
  for version in "$keep_current" "$keep_previous"; do
    if [ -n "$version" ] && [ -d "$RELEASES/$version" ]; then
      kept+=$(release_images "$version")$'\n' || true
    fi
  done
  for dir in "$RELEASES"/*/; do
    dir=${dir%/}
    version=${dir##*/}
    case "$version" in
      "$keep_current" | "$keep_previous") continue ;;
    esac
    while read -r image; do
      if [ -n "$image" ] && ! grep -qxF "$image" <<<"$kept"; then
        docker image rm "$image" >/dev/null 2>&1 || true
      fi
    done <<<"$(release_images "$version" || true)"
    rm -rf "$dir"
  done
}

# ── commands ─────────────────────────────────────────────────────────────────────────────────────

cmd_update() {
  local target="" force=false previous hint
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=true ;;
      -*) not_valid "$1" option "Run armada help." ;;
      *) target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || die "Usage: armada update <version|latest> [--force]"
  [ "$target" = latest ] && target=$(track_version)
  valid_version "$target" || not_valid "$target" version "Use one like 1.2.0, or latest."
  previous=$(setting VERSION)
  if [ "$target" = "$previous" ] && all_healthy; then
    say "Already running $target."
    return 0
  fi

  begin_run_log
  say "Updating ${previous:-a new installation} to $target"
  # status reads this only while the lock is held, so one left behind by a crash is never shown.
  set_state UPDATING_TO "$target"
  fetch_release "$target"
  if [ -n "$previous" ] && ! $force && downgrade_blocked "$previous" "$target"; then
    set_state UPDATING_TO ""
    die "$target cannot read the database schema $previous left behind, so moving to it was refused and nothing was changed. If the database has been restored to suit $target, run: armada update $target --force"
  fi

  # up itself fails when a service another one depends on never becomes healthy, so its failure is
  # handled like a timeout rather than ending armada before the previous version is restored.
  if bring_up "$target" true up --detach --remove-orphans; then
    [ -n "$previous" ] && [ "$previous" != "$target" ] && set_state PREVIOUS_VERSION "$previous"
    set_state INSTALLED_AT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    set_state AVAILABLE_VERSION ""
    set_state DOWNGRADE_BLOCKED ""
    set_state UPDATING_TO ""
    install_tooling "$target"
    prune_releases
    say "Now running $target."
    return 0
  fi

  set_state UPDATING_TO ""
  show_run_log
  if [ "$BRING_UP_FAILED" = download ]; then
    die "Could not download $target, so nothing was changed. Check the connection and the registry login, then try again."
  fi
  warn "$target did not become healthy."
  compose ps --all --format '  {{.Service}}: {{.State}} {{.Health}}' >&2 || true
  # Read before any return to the previous version replaces the target's containers.
  hint=$(not_healthy_hint "$target")
  if [ -z "$previous" ]; then
    warn "$target is the first version on this machine, so there is no earlier one to return to. It is left as it is, so you can see what failed: armada logs <service>, for a service listed above."
    die "$hint"
  fi
  if downgrade_blocked "$target" "$previous"; then
    warn "$target changed the database schema in a way $previous cannot read, so it is not returned to. $target is left as it is, so you can see what failed: armada logs <service>, for a service listed above."
    die "$hint"
  fi
  warn "$hint"
  warn "Returning to $previous."
  set_setting VERSION "$previous"
  if ! bring_up "$previous" false up --detach --remove-orphans; then
    warn "$previous did not come back healthy either. See: armada logs"
  fi
  return 1
}

cmd_rollback() {
  local target="" confirmed=false force=false from
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) confirmed=true ;;
      --force) force=true ;;
      -*) not_valid "$1" option "Run armada help." ;;
      *) target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || target=$(state PREVIOUS_VERSION)
  [ -n "$target" ] || die "No previous version is recorded. Name one: armada rollback <version>"
  from=$(setting VERSION)
  if ! $confirmed; then
    [[ $(ask "Roll back from $from to $target? (y/n)" n) =~ ^[Yy] ]] ||
      die "Nothing was changed."
  fi
  say "Rolling back to $target"
  if $force; then
    cmd_update "$target" --force || return 1
  else
    cmd_update "$target" || return 1
  fi
  # Automatic updates would otherwise reinstall the version just rolled back from at the next
  # check. Undoing a rollback returns to that version, so it lifts the pause instead.
  if [ "$target" = "$(state ROLLED_BACK_FROM)" ]; then
    set_state ROLLED_BACK_FROM ""
  elif [ -n "$from" ] && [ "$from" != "$target" ]; then
    set_state ROLLED_BACK_FROM "$from"
    [ "$(setting UPDATE_POLICY notify)" = auto ] &&
      say "Automatic updates skip $from until the track names another version, or until: armada update latest"
  fi
  return 0
}

# The timer runs this with --scheduled, which obeys the update policy and window.
cmd_check_for_updates() {
  local scheduled=false policy latest current window rolled_back_from
  [ "${1:-}" = --scheduled ] && scheduled=true
  policy=$(setting UPDATE_POLICY notify)
  if $scheduled && [ "$policy" = off ]; then
    return 0
  fi
  latest=$(track_version)
  current=$(setting VERSION)
  set_state LAST_CHECK "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "$latest" = "$current" ]; then
    set_state AVAILABLE_VERSION ""
    set_state DOWNGRADE_BLOCKED ""
    if preview_track; then
      say "Up to date: $current is the newest on the $(setting TRACK) track."
    else
      say "Up to date: $current is the newest version."
    fi
    return 0
  fi
  # Follows the pointer down as well as up, so moving a pointer back rolls installations back,
  # except past a non-additive migration: that version's code cannot read this machine's schema.
  if [ -n "$current" ]; then
    fetch_release "$latest"
    if downgrade_blocked "$current" "$latest"; then
      set_state AVAILABLE_VERSION ""
      set_state DOWNGRADE_BLOCKED "$latest"
      say "Not moving to $latest: it cannot read the database schema $current uses. Staying on $current until the track names a version that can. If the database has been restored to suit $latest: armada update $latest --force"
      return 0
    fi
  fi
  set_state DOWNGRADE_BLOCKED ""
  set_state AVAILABLE_VERSION "$latest"
  say "$latest is available; running ${current:-nothing}."
  window=$(setting UPDATE_WINDOW)
  rolled_back_from=$(state ROLLED_BACK_FROM)
  # Once the track names another version, the rollback has been answered and the pause ends.
  if [ -n "$rolled_back_from" ] && [ "$latest" != "$rolled_back_from" ]; then
    set_state ROLLED_BACK_FROM ""
    rolled_back_from=""
  fi
  if [ "$policy" = auto ] && [ -n "$rolled_back_from" ]; then
    say "Not installing it automatically: this machine was rolled back from $latest. Automatic updates resume when the track names another version. To install it now: armada update $latest"
  # An update restarts Armada, so automatic ones wait for the window the operator chose.
  elif $scheduled && [ "$policy" = auto ]; then
    if in_window "$window"; then
      cmd_update "$latest"
    else
      say "Not installing it yet: automatic updates restart Armada, so they wait for the update window, $window."
    fi
  elif ! $scheduled; then
    if [ "$policy" = auto ]; then
      say "It installs itself at the next scheduled check${window:+ inside the update window, $window $(date +%Z)}. To install it now: armada update $latest"
    else
      say "Install it with: armada update $latest"
    fi
  fi
}

certificate_expiry() {
  local domain=$1
  [[ $domain == :* ]] && return 0
  command -v openssl >/dev/null || return 0
  echo | timeout 5 openssl s_client -connect 127.0.0.1:443 -servername "$domain" 2>/dev/null |
    openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || true
}

# Times are stored in UTC and shown in the machine's own zone, the one the update window uses.
local_time() { date -d "$1" '+%Y-%m-%d %H:%M %Z' 2>/dev/null || printf '%s' "$1"; }

# Whether an update is running now. Another armada command holds the lock while it works; the
# subshell takes and drops it at once, so status never holds it.
updating() {
  [ -n "$(state UPDATING_TO)" ] && [ -e "$LOCK_FILE" ] && ! (flock --nonblock 9) 9<"$LOCK_FILE"
}

# The timer's next run, from both its interval and its window, in the machine's zone. list-timers
# prints "-" or "n/a" in the NEXT column when nothing is scheduled.
next_check() {
  systemctl list-timers "$TIMER" --all --no-legend 2>/dev/null |
    awk '$1 == "-" || $1 == "n/a" { exit } { print $2, substr($3, 1, 5), $4; exit }'
}

# The label column of status, in the heading colour, followed by a space.
field() { printf '  %s%-12s%s ' "$BLUE" "$1" "$RESET"; }

# A container or migration state, padded to a width, coloured by whether it is good, on its way
# or wrong. A stopped migration is neither: it ran, and a reboot ended its container.
state_word() {
  local colour=""
  case "$1" in
    running | healthy | migrated) colour=$GREEN ;;
    created | starting | restarting | migrating | paused) colour=$YELLOW ;;
    unhealthy | exited | dead | removing | failed | timed-out) colour=$RED ;;
  esac
  printf '%s%-*s%s' "$colour" "$2" "$1" "$RESET"
}

status_updates() {
  local policy window next last_check rolled_back_from downgrade_blocked
  downgrade_blocked=$(state DOWNGRADE_BLOCKED)
  if [ -n "$downgrade_blocked" ]; then
    field Blocked
    printf '%s%s cannot read this database schema, so the track is not followed back to it%s\n' \
      "$YELLOW" "$downgrade_blocked" "$RESET"
  fi
  policy=$(setting UPDATE_POLICY notify)
  if [ "$policy" = off ]; then
    field Updates
    printf 'off\n'
    return 0
  fi
  window=$(setting UPDATE_WINDOW)
  next=$(next_check)
  last_check=$(state LAST_CHECK)
  rolled_back_from=$(state ROLLED_BACK_FROM)
  field Updates
  printf '%s, checked every %s, %s\n' "$policy" "$(setting UPDATE_INTERVAL 6h)" \
    "$([ -n "$window" ] && printf 'window %s %s' "$window" "$(date +%Z)" || printf 'window any time')"
  field ''
  printf 'last checked %s, next %s\n' \
    "$([ -n "$last_check" ] && local_time "$last_check" || printf never)" "${next:-not scheduled}"
  if [ "$policy" = auto ] && [ -n "$rolled_back_from" ]; then
    field ''
    printf '%spaused for %s, which this machine was rolled back from%s\n' \
      "$YELLOW" "$rolled_back_from" "$RESET"
  fi
}

cmd_status() {
  local version available health migration expiry disk root
  version=$(setting VERSION)
  available=$(state AVAILABLE_VERSION)
  printf '%s  %s\n' "$(heading Armada)" "$BOLD$(setting DOMAIN)$RESET"
  if updating; then
    field Version
    printf '%s%s -> updating to %s%s\n' "$YELLOW" "${version:-none}" "$(state UPDATING_TO)" "$RESET"
    if preview_track; then
      field Track
      printf '%s\n' "$(setting TRACK)"
    fi
    say "Run armada status again once the update finishes."
    return 0
  fi
  field Version
  printf '%s   (installed %s)\n' "${version:-none}" "$(local_time "$(state INSTALLED_AT unknown)")"
  if preview_track; then
    field Track
    printf '%s\n' "$(setting TRACK)"
  fi
  status_updates
  if [ -n "$available" ]; then
    field ''
    printf '%s-> %s is available. To install it: armada update %s%s\n' \
      "$YELLOW" "$available" "$available" "$RESET"
  fi
  [ -n "$version" ] || return 0

  if all_healthy; then
    health="${GREEN}OK${RESET}"
  else
    health="${RED}NOT HEALTHY${RESET}  (see: armada logs)"
  fi
  field Health
  printf '%s\n' "$health"
  migration=$(migration_state)
  compose ps --all --format '{{.Service}} {{.State}} {{.Health}}' |
    while read -r service status condition; do
      field ''
      # migrate is a step, so its row says how the migration went rather than a container state.
      if [ "$service" = migrate ]; then
        printf '%-20s %s\n' "$service" "$(state_word "$migration" 0)"
      else
        printf '%-20s %s %s\n' "$service" "$(state_word "$status" 10)" "$(state_word "${condition:--}" 0)"
      fi
    done
  expiry=$(certificate_expiry "$(setting DOMAIN)")
  if [ -n "$expiry" ]; then
    field Certificate
    printf 'renewed automatically; this one is valid until %s\n' "$(local_time "$expiry")"
  fi
  root=$(docker info --format '{{.DockerRootDir}}')
  disk=$(df -h --output=used,size "$root" | tail -n 1 | awk '{print $1 " used of " $2}')
  field Disk
  printf '%s\n' "$disk"
}

cmd_logs() {
  local service="" lines=200
  if [[ ${1:-} =~ ^[0-9]+$ ]]; then
    lines=$1
  else
    service=${1:-}
    [[ ${2:-} =~ ^[0-9]+$ ]] && lines=$2
  fi
  compose logs --follow --tail "$lines" ${service:+"$service"}
}

installed_version() {
  local version
  version=$(setting VERSION)
  [ -n "$version" ] || die "No version is installed yet. Run: armada update latest"
  printf '%s' "$version"
}

cmd_restart() {
  local version
  version=$(installed_version) || exit 1
  begin_run_log
  # Stopped first rather than with compose restart, which would leave every service healthy at
  # the first count and drop each one back as it restarts, so the bar would fall from 100%.
  quiet_step "Stopping Armada" compose stop || die "Could not stop Armada to restart it."
  if ! bring_up "$version" false up --detach --remove-orphans; then
    show_run_log
    die "Not healthy after restarting. See: armada logs"
  fi
  say "Restarted."
}

cmd_stop() {
  begin_run_log
  quiet_step "Stopping Armada" compose down || die "Could not stop Armada."
  say "Stopped. Data is kept; start again with: armada start"
}

cmd_start() {
  local version
  version=$(installed_version) || exit 1
  begin_run_log
  if ! bring_up "$version" false up --detach --remove-orphans; then
    show_run_log
    die "Not healthy after starting. See: armada logs"
  fi
  say "Started."
}

# ── settings ─────────────────────────────────────────────────────────────────────────────────────

# Reads from the terminal even when the script itself arrived on standard input.
ask() {
  local prompt=$1 default=${2:-} answer
  if [ -n "$default" ]; then prompt="$prompt [$default]"; fi
  read -r -p "$prompt: " answer </dev/tty
  printf '%s' "${answer:-$default}"
}

ask_valid() {
  local key=$1 prompt=$2 default=${3:-} value reason
  while :; do
    value=$(ask "$prompt" "$default")
    # check_value dies on a bad value; the subshell keeps that from ending armada, and its message
    # says what was wrong.
    if reason=$( (check_value "$key" "$value") 2>&1); then
      printf '%s' "$value"
      return 0
    fi
    say "${reason#armada: } Try again." >/dev/tty
  done
}

# Warns, never blocks: somebody midway through a DNS change may continue on purpose.
check_dns() {
  local domain=$1 resolved
  [[ $domain == :* ]] && return 0
  resolved=$(getent ahosts "$domain" | awk '{print $1}' | sort -u) || resolved=""
  if [ -z "$resolved" ]; then
    warn "$domain does not resolve yet. HTTPS starts working once it points at this machine."
  elif ! grep -qxF -f <(hostname -I | tr ' ' '\n' | grep .) <<<"$resolved"; then
    warn "$domain resolves to $(tr '\n' ' ' <<<"$resolved")which is not this machine. HTTPS needs it to point here."
  fi
}

# Writes the timer's settings from .env. The random spread is a quarter of the interval, at most 15
# minutes, so a short interval on a testing machine is not swamped by it. The interval counts from
# the last check and drifts, so it can miss a short update window for days; automatic updates with
# a window therefore also check when the window opens.
write_timer() {
  local dir="$UNIT_DIR/$TIMER.d" interval window seconds spread
  interval=$(setting UPDATE_INTERVAL 6h)
  window=$(setting UPDATE_WINDOW)
  seconds=$(($(systemd-analyze timespan "$interval" | awk '/μs:/ {print $2}') / 1000000))
  spread=$((seconds / 4 < 900 ? seconds / 4 : 900))
  mkdir -p "$dir"
  # An empty assignment clears every trigger in the unit, not just that one, so the first check
  # after the timer starts is restated with the interval.
  printf '[Timer]\nOnUnitActiveSec=\nOnActiveSec=5min\nOnUnitActiveSec=%s\nRandomizedDelaySec=%ss\n' \
    "$interval" "$spread" >"$dir/interval.conf"
  if [ "$(setting UPDATE_POLICY notify)" = auto ] && [ -n "$window" ]; then
    printf '[Timer]\nOnCalendar=*-*-* %s:00\n' "${window%-*}" >"$dir/window.conf"
  else
    rm -f "$dir/window.conf"
  fi
  systemctl daemon-reload
  systemctl is-active --quiet "$TIMER" && systemctl restart "$TIMER"
  return 0
}

# Shared by install.sh (with --install) and by people re-answering the questions. Flags answer a
# question in advance; --non-interactive makes a missing answer an error instead of a prompt.
cmd_reconfigure() {
  local installing=false interactive=true domain="" email="" policy="" window="" interval="" set_window=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --install) installing=true ;;
      --non-interactive) interactive=false ;;
      --domain) domain=${2:?--domain needs a value}; shift ;;
      --admin-email) email=${2:?--admin-email needs a value}; shift ;;
      --update-policy) policy=${2:?--update-policy needs a value}; shift ;;
      --update-window) window=${2-}; set_window=true; shift ;;
      --update-interval) interval=${2:?--update-interval needs a value}; shift ;;
      *) not_valid "$1" option "Run armada help." ;;
    esac
    shift
  done

  while :; do
    if $interactive; then
      if [ -z "$domain" ]; then
        say ""
        say "The domain's DNS record must point straight at this machine and must not be proxied"
        say "in any way. HTTPS certificates cannot be issued through a proxy."
        domain=$(ask_valid domain "Domain name for this server" "$(setting DOMAIN)")
      fi
      check_dns "$domain"
      if [ -z "$email" ]; then
        say ""
        email=$(ask_valid admin-email "Administrator email address" "$(setting ADMIN_EMAIL)")
      fi
      if [ -z "$policy" ]; then
        say ""
        say "Updates: notify tells you a new version exists, auto installs it, off never checks."
        policy=$(ask_valid update-policy "Update policy (notify, auto or off)" "$(setting UPDATE_POLICY notify)")
      fi
      if [ "$policy" = auto ] && ! $set_window; then
        say ""
        say "Automatic updates restart Armada, so they can be kept to a daily window. Times are"
        say "24-hour, on this machine's clock (now $(date '+%H:%M %Z')), and a window may cross midnight,"
        say "such as 23:00-02:00."
        window=$(ask_valid update-window "Install updates only between, e.g. 02:00-05:00 (empty for any time)" "$(setting UPDATE_WINDOW)")
        set_window=true
      fi
    fi
    [ -n "$domain" ] || domain=$(setting DOMAIN)
    [ -n "$email" ] || email=$(setting ADMIN_EMAIL)
    [ -n "$policy" ] || policy=$(setting UPDATE_POLICY notify)
    $set_window || window=$(setting UPDATE_WINDOW)
    [ -n "$interval" ] || interval=$(setting UPDATE_INTERVAL 6h)
    [ -n "$domain" ] || die "A domain is required: --domain"
    [ -n "$email" ] || die "An administrator email is required: --admin-email"
    check_value domain "$domain"
    check_value admin-email "$email"
    check_value update-policy "$policy"
    check_value update-window "$window"
    check_value update-interval "$interval"

    $interactive || break
    say ""
    say "  Domain         $domain"
    say "  Admin email    $email"
    say "  Updates        $policy${window:+, between $window $(date +%Z)}"
    [[ $(ask "Is this right? (y/n)" y) =~ ^[Yy] ]] && break
    domain="" email="" policy="" window="" set_window=false
  done

  set_setting DOMAIN "$domain"
  set_setting ADMIN_EMAIL "$email"
  set_setting UPDATE_POLICY "$policy"
  set_setting UPDATE_WINDOW "$window"
  set_setting UPDATE_INTERVAL "$interval"
  write_timer

  if ! $installing && [ -n "$(setting VERSION)" ]; then
    cmd_start
  fi
}

cmd_config() {
  local name=${1:-} key track
  if [ -z "$name" ]; then
    track=$(track_key || true)
    cat >&2 <<EOF
Usage: armada config <key>            shows the key's current value
       armada config <key> <value>    changes it
Keys:  domain, admin-email,${track} update-policy, update-window, update-interval
EOF
    exit 1
  fi
  key=$(setting_key "$name")
  if [ $# -lt 2 ]; then
    say "$(setting "$key")"
    return 0
  fi
  check_value "$name" "$2"
  # Rewriting an unchanged value would still restart the stack or the timer, for nothing.
  if [ "$(setting "$key")" = "$2" ]; then
    say "$name is already ${2:-empty}."
    return 0
  fi
  # Testing and staging share the private packages; production's are different packages with a
  # different installer, so crossing between them is a reinstall.
  if [ "$name" = track ] && [ "$(preview_track "$2" && echo y)" != "$(preview_track && echo y)" ]; then
    die "Moving between production and testing or staging means reinstalling from the other channel. See infra/deploy/README.md."
  fi
  set_setting "$key" "$2"
  case "$name" in
    domain | admin-email) [ -n "$(setting VERSION)" ] && cmd_start ;;
    update-policy | update-window | update-interval) write_timer ;;
  esac
  say "$name is now ${2:-empty}."
  # Says whether a newer version will now install itself, so that is no surprise. A failed check
  # leaves the policy changed, since the timer checks again anyway.
  if [ "$name" = update-policy ] && [ "$2" = auto ] && [ -n "$(setting VERSION)" ]; then
    (cmd_check_for_updates) || warn "Could not check for a newer version just now."
  fi
}

cmd_uninstall() {
  local delete_data=false confirmed=false volumes
  while [ $# -gt 0 ]; do
    case "$1" in
      --delete-data) delete_data=true ;;
      --yes) confirmed=true ;;
      *) not_valid "$1" option "Run armada help." ;;
    esac
    shift
  done
  # --yes skips only the plain confirmation. Deleting data always needs the domain typed back.
  if $delete_data; then
    say "This permanently deletes the database, every stored file and the certificates."
    [ "$(ask "Type the domain, $(setting DOMAIN), to confirm")" = "$(setting DOMAIN)" ] ||
      die "Not confirmed; nothing was removed."
  elif ! $confirmed; then
    [[ $(ask "Remove Armada from this machine? Data is kept. (y/n)" n) =~ ^[Yy] ]] ||
      die "Nothing was removed."
  fi

  if [ -n "$(setting VERSION)" ]; then
    begin_run_log
    quiet_step "Stopping Armada" compose down || die "Could not stop Armada, so nothing was removed."
  fi
  systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
  rm -rf "${UNIT_DIR:?}/$TIMER" "${UNIT_DIR:?}/$SERVICE" "${UNIT_DIR:?}/$TIMER.d"
  systemctl daemon-reload
  rm -rf "$RELEASES" "$STATE_FILE" "$BIN"

  if $delete_data; then
    volumes=$(docker volume ls --quiet --filter label=com.docker.compose.project=armada)
    [ -z "$volumes" ] || xargs docker volume rm <<<"$volumes" >/dev/null
    rm -rf "$ARMADA_HOME"
    say "Armada and its data are removed."
  else
    # The data volumes only open with the passwords in .env, so it stays for a reinstall.
    set_setting VERSION ""
    say "Armada is removed. Data and $ENV_FILE are kept; installing again picks them up."
  fi
}

# ── entry point ──────────────────────────────────────────────────────────────────────────────────

# The timer and a person must never change the installation at the same time. A person waits for
# the timer to finish; the timer skips a turn rather than queue behind a person.
take_lock() {
  exec 9>"$LOCK_FILE"
  flock --nonblock 9 && return 0
  [ "${1:-}" = --scheduled ] && return 1
  say "Waiting for another armada command to finish..."
  flock --wait 900 9 || die "Another armada command is still running."
}

main() {
  local command=${1:-help}
  [ $# -gt 0 ] && shift
  case "$command" in
    help | -h | --help)
      usage
      return 0
      ;;
  esac
  [ "$(id -u)" -eq 0 ] || die "Run as root: sudo armada $command"
  [ -f "$ENV_FILE" ] || die "Armada is not installed here ($ENV_FILE is missing). Run install.sh."
  umask 022

  case "$command" in
    status | logs | version | config) ;;
    check-for-updates)
      if [ "${1:-}" = --scheduled ]; then
        take_lock --scheduled || return 0
      else
        take_lock
      fi
      ;;
    *) take_lock ;;
  esac

  case "$command" in
    # Choosing a version by hand answers a rollback, so automatic updates resume.
    update) cmd_update "$@" && set_state ROLLED_BACK_FROM "" ;;
    rollback) cmd_rollback "$@" ;;
    check-for-updates) cmd_check_for_updates "$@" ;;
    version) say "$(setting VERSION)" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    restart) cmd_restart ;;
    stop) cmd_stop ;;
    start) cmd_start ;;
    reconfigure) cmd_reconfigure "$@" ;;
    config)
      [ $# -lt 2 ] || take_lock
      cmd_config "$@"
      ;;
    uninstall) cmd_uninstall "$@" ;;
    *)
      usage >&2
      echo >&2
      not_valid "$command" command "The commands are listed above."
      ;;
  esac
}

main "$@"
