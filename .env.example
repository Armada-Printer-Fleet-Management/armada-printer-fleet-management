# Copy to .env and fill in. .env is gitignored; this example is committed.
# `/onboarding` creates it for you.

# ─── AI audit log ────────────────────────────────────────────────────────────
# Where agent session transcripts are exported. Required by .integrity/POLICY.md.
#
# This must be the OneDrive shortcut to the team's shared audit directory, so
# that exports land somewhere the team can actually see them. A local folder
# will appear to work and log nothing to anyone but you.
#
# The script creates ai-audit-log/<author>/ underneath this path.
AI_AUDIT_LOG_DIR=REPLACE_ME

# Your name as firstname.lastname, matching the branch naming convention.
AI_AUDIT_AUTHOR=REPLACE_ME

# Optional. Extra directories holding session records from other AI tools,
# separated by the platform path separator (`;` on Windows, `:` elsewhere).
# Claude Code and Copilot CLI are found automatically.
AI_AUDIT_EXTRA_SOURCES=

# ─── Jira ────────────────────────────────────────────────────────────────────
# Your Atlassian site, e.g. https://your-site.atlassian.net
JIRA_SITE_URL=REPLACE_ME

# The project abbreviation used in ticket IDs and branch names.
JIRA_PROJECT_KEY=REPLACE_ME
